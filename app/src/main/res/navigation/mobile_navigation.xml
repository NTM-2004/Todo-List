<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/fragment_home">

    <!-- Home (tabs: All / Incomplete / Complete) -->
    <fragment
        android:id="@+id/fragment_home"
        android:name="com.example.todolist.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <!-- Statistics -->
    <fragment
        android:id="@+id/fragment_statistics"
        android:name="com.example.todolist.fragments.StatisticsFragment"
        android:label="Thống kê"
        tools:layout="@layout/fragment_statistics" />

    <!-- Add / Edit Task (reached from HomeFragment or FAB) -->
    <fragment
        android:id="@+id/fragment_add_task"
        android:name="com.example.todolist.fragments.AddTaskFragment"
        android:label="Thêm / Sửa Task"
        tools:layout="@layout/fragment_add_task">

        <argument
            android:name="taskId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

</navigation>