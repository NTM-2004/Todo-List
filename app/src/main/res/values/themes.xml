<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme chính: Sử dụng Material3 làm gốc nhưng hỗ trợ các thuộc tính Material2 -->
    <style name="Theme.TodoList" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/color_primary</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- StatusBar & NavigationBar -->
        <item name="android:statusBarColor">@color/color_primary_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>

        <!-- Cung cấp các thuộc tính Material2 để tránh crash TextInputLayout -->
        <item name="textAppearanceSubtitle1">?attr/textAppearanceBodyLarge</item>
        <item name="textAppearanceSubtitle2">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Theme.TodoList.NoActionBar" parent="Theme.TodoList" />
    <style name="Theme.TodoList.Auth" parent="Theme.TodoList" />
    <style name="Theme.TodoList.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.TodoList.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>