<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Đồng bộ với theme chính sử dụng Material3 -->
    <style name="Theme.TodoList" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/color_primary</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

    <style name="Theme.TodoList.NoActionBar" parent="Theme.TodoList" />
</resources>